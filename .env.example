# 复制为 .env 后按需修改：Copy-Item .env.example .env

# 必填：绑定到本机的域名（DNS A 记录需指向服务器公网 IP，且 80/443 已放行）
DOMAIN=dance.example.com

# 可选：Let's Encrypt 通知邮箱
EMAIL=you@example.com

# 可选：业务参数
SEGMENT_SECONDS=10
RECORD_FPS=24
MAX_UPLOAD_MB=800

# 可选：推理后端 auto（默认）/ mediapipe / onnx
# auto：装了 onnxruntime 且模型已下载时用 GPU，否则回退 MediaPipe
DANCEMATE_POSE_BACKEND=auto
# ONNX Runtime 执行提供程序：cpu（默认）/ dml（Windows DirectML）/ cuda
# 本机实测 256x256 姿态模型 CPU 17.5ms/帧、DML 36ms/帧，DML 双会话还会偶发 0x80004005，故默认 CPU
DANCEMATE_ORT_PROVIDER=cpu
# 每隔多少帧重跑一次人体检测（中间帧复用 ROI）；3 帧兼顾跟手与开销
DANCEMATE_ORT_DETECT_INTERVAL=3

# 人物阴影来源：blazepose（默认，与骨架同一次推理）/ yolo（YOLO26n-seg，更精细但抢 CPU）
# 实测同一批帧：yolo 每帧 avg 26ms / p95 63ms，blazepose avg 19ms / p95 34ms
DANCEMATE_MASK_BACKEND=blazepose
DANCEMATE_YOLO_IMGSZ=640
# 仅 MASK_BACKEND=yolo 时生效：每隔多少帧更新一次阴影（中间帧复用上一张掩码）
DANCEMATE_YOLO_MASK_INTERVAL=4

# 可选：本地语音指令（麦克风常驻 + 唤醒词 + faster-whisper + Ollama）
DANCEMATE_VOICE=1
DANCEMATE_WAKE_WORD=小教练
# 模型目录：backend/models/whisper-base（可用 whisper-small，精度更高但更慢）
DANCEMATE_WHISPER_MODEL=whisper-base
DANCEMATE_WHISPER_COMPUTE=int8
DANCEMATE_OLLAMA_URL=http://127.0.0.1:11434
DANCEMATE_OLLAMA_MODEL=qwen2.5:1.5b-instruct

# 可选：模型下载路由（默认「镜像直连 → 官方直连 → 镜像/官方 + 代理」）
# 代理未显式配置时读 HTTP(S)_PROXY，再探测本机 7890（Clash 默认端口）
# DANCEMATE_PROXY=http://127.0.0.1:7890
# HuggingFace 镜像，默认 hf-mirror.com（下载 faster-whisper 用）
# DANCEMATE_HF_ENDPOINT=https://hf-mirror.com
# 设为 1 则只直连、不做代理回退
# DANCEMATE_NO_PROXY=1
